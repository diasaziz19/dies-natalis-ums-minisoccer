// prisma/schema.prisma
// Database Schema - Dies Natalis UMS 2026 Minisoccer Tournament

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  COMMITTEE_REFEREE
  TEAM_MANAGER
}

enum TeamStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum OfficialRole {
  HEAD_COACH
  OFFICIAL
}

enum MatchStage {
  GROUP_STAGE
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
}

enum EventType {
  GOAL
  PENALTY_GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SECOND_YELLOW_RED
  SUBSTITUTION
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(TEAM_MANAGER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teams         Team[]    @relation("ManagerTeams")
}

model Team {
  id            String      @id @default(uuid())
  name          String      @unique
  facultyUnit   String      // Fakultas / Unit di UMS
  logoUrl       String?
  managerId     String
  manager       User        @relation("ManagerTeams", fields: [managerId], references: [id])
  managerPhone  String
  status        TeamStatus  @default(PENDING)
  rejectionNote String?
  groupName     String?     // "Group A", "Group B", dst.
  potNumber     Int?        // Pot 1, Pot 2, Pot 3, Pot 4
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  players       Player[]
  officials     Official[]
  homeMatches   Match[]     @relation("HomeTeam")
  awayMatches   Match[]     @relation("AwayTeam")
  standing      Standing?
}

model Player {
  id              String         @id @default(uuid())
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName        String
  identityNumber   String         // NIM (Mahasiswa) / NIDN (Dosen) / KTP
  position        PlayerPosition
  jerseyNumber    Int            // 1 - 99 (Unik per tim)
  photoIdUrl      String?        // Kartu Identitas
  photoProfileUrl String?        // Foto Profil
  isSuspended     Boolean        @default(false)
  suspensionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  goals           MatchEvent[]   @relation("GoalScorer")
  assists         MatchEvent[]   @relation("GoalAssister")
  cards           Card[]

  @@unique([teamId, jerseyNumber])
}

model Official {
  id              String       @id @default(uuid())
  teamId          String
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName        String
  identityNumber   String
  role            OfficialRole // HEAD_COACH / OFFICIAL
  photoProfileUrl String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Match {
  id            String      @id @default(uuid())
  stage         MatchStage  @default(GROUP_STAGE)
  groupName     String?     // "Group A", "Group B", dst.
  matchNumber   Int
  homeTeamId    String
  homeTeam      Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId    String
  awayTeam      Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore     Int         @default(0)
  awayScore     Int         @default(0)
  pitchLocation String      // e.g. "Lapangan A UMS Stadium"
  kickoffTime   DateTime
  status        MatchStatus @default(SCHEDULED)
  refereeNotes  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  events        MatchEvent[]
  cards         Card[]
}

model MatchEvent {
  id            String    @id @default(uuid())
  matchId       String
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute        Int
  eventType     EventType
  teamId        String
  playerId      String?
  player        Player?   @relation("GoalScorer", fields: [playerId], references: [id])
  assistId      String?
  assister      Player?   @relation("GoalAssister", fields: [assistId], references: [id])
  notes         String?
  createdAt     DateTime  @default(now())
}

model Card {
  id             String    @id @default(uuid())
  matchId        String
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId         String
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  minute         Int
  isRedCard      Boolean   @default(false)
  isSecondYellow Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model Standing {
  id             String    @id @default(uuid())
  groupName      String    // "Group A", "Group B", dst.
  teamId         String    @unique
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played         Int       @default(0)
  won            Int       @default(0)
  drawn          Int       @default(0)
  lost           Int       @default(0)
  goalsFor       Int       @default(0)
  goalsAgainst   Int       @default(0)
  goalDifference Int       @default(0)
  points         Int       @default(0)
  yellowCards    Int       @default(0)
  redCards       Int       @default(0)
  fairPlayPoints Int       @default(0)
  rank           Int       @default(0)
  updatedAt      DateTime  @updatedAt
}
